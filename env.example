PORT=3000
NODE_ENV=development

# Optional: Upstash Redis for persistent caching (recommended for production)
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here

# Cache TTL in seconds
CACHE_TTL_MAPPING=86400
CACHE_TTL_EPISODES=3600
CACHE_TTL_STREAM=300

# --- Site-id cache: resolved animeheaven/anikoto/desidub slugs per anime ---
# Every level is opt-in. Leave a variable empty to disable that level.
# L1: shared Redis. Instances pointing at the same Redis share resolutions.
SITEIDS_REDIS_URL=
SITEIDS_REDIS_TTL=604800
# L2: permanent SQLite file (survives restarts and Redis flushes).
SITEIDS_DB_PATH=
# Seconds before a provider that was searched and not found is searched again.
SITEIDS_NEGATIVE_TTL=1800

# Optional: resolve the AniList title/malId through your own metadata service instead of
# graphql.anilist.co directly (falls back to AniList on any failure).
# "<ANILIST_META_BASE_URL>/<anilistId>" must return { id, title: { romaji, english }, malId }
ANILIST_META_BASE_URL=
ANILIST_META_TIMEOUT_MS=5000

# Optional legacy zoro/gogoanime mapping source ("<base>/<anilistId>?fields=mappings").
# Off when empty. Nothing in the routes uses those ids.
ANIFY_MAPPINGS_URL=

# Enables DELETE /api/cache/siteids/:anilistId (send the token as x-admin-token).
# The endpoint is disabled while this is empty.
ADMIN_TOKEN=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# TMDB — used by src/scrapers/tmdb.ts for /api/tmdb/episode-thumb
TMDB_API_KEY=

# One-off InfinityFree -> R2 image migration tool (src/image-migrator.ts)
# Delete these + the route once the migration is done.
FTP_HOST=ftpupload.net
FTP_USER=
FTP_PASSWORD=
FTP_REMOTE_DIR=/htdocs/assets/img/anime-library
MIGRATE_ACCESS_KEY=
